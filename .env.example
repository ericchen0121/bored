DATABASE_URL=postgres://bored:bored@localhost:5432/bored
# Set DATABASE_SSL=1 for managed Postgres that needs TLS without sslmode in the URL
# DATABASE_SSL=1
API_PORT=4000
# Production (Railway): PORT is injected; API also reads PORT. Web binds 0.0.0.0.
WEB_ORIGIN=http://localhost:3000
# Phone testing: `pnpm dev` auto-binds LAN when Wi‑Fi is up. Do not hardcode LAN IPs here.
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# Public API URL for the Next.js client (required in production builds)
# NEXT_PUBLIC_API_URL=https://api.example.com
# Magic-link auth (optional — without RESEND_API_KEY links log to API stdout in dev)
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=Bored <hello@yourdomain.com>
# Public web origin — required in production for canonical URLs, JSON-LD, OG images, sitemap, llms.txt
# Set on the web service at build time (Railway Docker build-arg / variable).
# NEXT_PUBLIC_SITE_URL=https://bored-app.up.railway.app

# Ops admin (/admin + /v1/admin/*). Required for admin APIs.
ADMIN_TOKEN=

# Anonymous Today feed in-memory cache TTL (ms). Default 15 minutes.
# TODAY_FEED_CACHE_TTL_MS=900000

# Outbound affiliates (optional — UTMs always applied on /r/* redirects)
TICKETMASTER_AFFILIATE_ID=
EVENTBRITE_AFFILIATE_CODE=
OUTBOUND_UTM_SOURCE=bored
OUTBOUND_UTM_MEDIUM=feed

# Optional Phase 1 API keys (adapters no-op gracefully without them)
TICKETMASTER_API_KEY=
TMS_API_KEY=
# Google Places API — hero photos for food deals when editorial sources lack images
GOOGLE_MAPS_API_KEY=
# Mapbox GL — public token for /{city}/map (client-side)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Product analytics (PostHog). Omit locally to no-op. Web build-time for production.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# YouTube Data API (free quota) — trailer search when Letterboxd/RT have no embed
YOUTUBE_API_KEY=
IG_ACCESS_TOKEN=
IG_BUSINESS_USER_ID=

# Ticket-page flyer scrape (19hz + text calendars). Chromium on the ingest host only.
# Default on. Set to 0 on hosts without Playwright browsers installed.
BROWSER_IMAGE_SCRAPE=1
# Max Chromium pages per ingest / backfill pass (allowlisted hosts only)
BROWSER_IMAGE_SCRAPE_CAP=40
BROWSER_IMAGE_SCRAPE_CONCURRENCY=2
# Production ingest worker: run Phase 1 once on process start (then cron continues)
# INGEST_RUN_ON_BOOT=1
